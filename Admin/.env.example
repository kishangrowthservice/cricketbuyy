# ==========================================
# Admin Application Environment Configuration
# ==========================================

# Node & Next.js Environment
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_APP_URL=https://cricketbuyy-admin.vercel.app

# Database (Supabase PostgreSQL)
# Direct connection for migrations & admin operations
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Pooled transaction connection (PgBouncer) for serverless actions
DATABASE_URL_POOLED=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Better Auth & Security Keys
BETTER_AUTH_SECRET=super_secret_32_byte_hex_or_random_string
BETTER_AUTH_URL=https://cricketbuyy-admin.vercel.app

# Redis / Rate Limiting (Upstash / Supabase Redis)
UPSTASH_REDIS_REST_URL=https://[YOUR_INSTANCE].upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Initial Super Admin Seed Credentials (used only during bootstrap)
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@cricketbuyy.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change_me_immediately_with_mfa

# Main Site Integration Secret (HMAC Signing)
MAIN_SITE_WEBHOOK_SECRET=your_hmac_sha256_webhook_signing_secret
